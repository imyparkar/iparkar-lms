{
 "schema": "iparkar.course-manifest/1",
 "course": {
  "code": "PMP-SPS",
  "title": "PMP® Exam Prep Course",
  "product": "iParkar Learning",
  "version": "1.0.0",
  "completion_policy": "all_required_chapters",
  "duration_hours": 35,
  "description": "A 35-hour, self-paced course aligned to the July 2026 PMP® Examination Content Outline and the PMBOK® Guide — Eighth Edition. Nine modules cover the People, Process, and Business Environment domains across predictive, adaptive, and hybrid delivery, with a knowledge check in every section and an end-of-course assessment."
 },
 "source": {
  "title": "iParkar Learning PMP® Exam Prep Course (original content)",
  "edition": "1.0",
  "stated_blueprint": "PMP® Examination Content Outline, July 2026",
  "blueprint_note": "Chapters map to the 26 tasks of the July 2026 PMP ECO (People 33%, Process 41%, Business Environment 26%). Module hours track PMI Talent Triangle® categories: Business Acumen 8 h, Ways of Working 19 h, Power Skills 8 h.",
  "references": [
   "PMI, The Standard for Project Management and A Guide to the Project Management Body of Knowledge (PMBOK® Guide), 8th ed., 2025",
   "PMI, PMP® Examination Content Outline, July 2026",
   "PMI® Certification Handbook, revised June 2026"
  ]
 },
 "domains": [
  {
   "domain": 1,
   "title": "Project management foundations and delivery approaches",
   "weight": 2.0,
   "chapter_count": 4,
   "summary": "What a project is, how projects create value inside an organization, the six principles and mindset that guide practice, and how to choose between predictive, adaptive, and hybrid delivery. This module sets the vocabulary used for the rest of the course.",
   "category_minutes": {
    "Business Acumen": 60,
    "Ways of Working": 60,
    "Power Skills": 0
   }
  },
  {
   "domain": 2,
   "title": "Shared vision, stakeholders, and governance",
   "weight": 4.0,
   "chapter_count": 6,
   "summary": "How to build and keep a shared vision, identify and analyze stakeholders, align and manage their expectations, and establish the governance — structures, decision rights, success criteria, and escalation paths — that keeps a project pointed at value.",
   "category_minutes": {
    "Business Acumen": 120,
    "Ways of Working": 0,
    "Power Skills": 120
   }
  },
  {
   "domain": 3,
   "title": "Scope, value, compliance, and success measures",
   "weight": 4.0,
   "chapter_count": 6,
   "summary": "Identifying value with stakeholders and measuring benefits, prioritizing and delivering value incrementally, eliciting requirements, defining and decomposing scope, planning for compliance (including health, safety, security, and sustainability), and validating that deliverables meet agreed success measures.",
   "category_minutes": {
    "Business Acumen": 180,
    "Ways of Working": 60,
    "Power Skills": 0
   }
  },
  {
   "domain": 4,
   "title": "Integrated planning, resources, and budgeting",
   "weight": 4.0,
   "chapter_count": 6,
   "summary": "Assessing project needs and complexity, building and maintaining an integrated plan, estimating effort and resources, planning and acquiring people and materials, estimating costs, building the budget and reserves, planning financial tracking and reporting, and using data — including AI-assisted analysis — to make sound planning decisions.",
   "category_minutes": {
    "Business Acumen": 0,
    "Ways of Working": 240,
    "Power Skills": 0
   }
  },
  {
   "domain": 5,
   "title": "Procurement, quality, and scheduling",
   "weight": 4.0,
   "chapter_count": 6,
   "summary": "Planning the sourcing strategy and make-or-buy decisions, selecting contract types and sellers, negotiating and managing suppliers, planning and optimizing quality (including cost of quality and sustainability), and building, baselining, and controlling schedules for predictive and adaptive work.",
   "category_minutes": {
    "Business Acumen": 0,
    "Ways of Working": 240,
    "Power Skills": 0
   }
  },
  {
   "domain": 6,
   "title": "Communication, collaboration, and team leadership",
   "weight": 5.0,
   "chapter_count": 7,
   "summary": "Defining a communication strategy, reporting transparently and building feedback loops, leading and empowering teams, developing teams and ground rules, managing conflict, transferring knowledge, and using emotional intelligence to build trust and influence.",
   "category_minutes": {
    "Business Acumen": 0,
    "Ways of Working": 0,
    "Power Skills": 300
   }
  },
  {
   "domain": 7,
   "title": "Risk, change, and performance",
   "weight": 6.0,
   "chapter_count": 8,
   "summary": "Planning, identifying, analyzing, responding to, and monitoring risks; removing impediments and managing issues; controlling change across delivery approaches; measuring performance with earned value and adaptive metrics; supporting organizational change; and responding to changes in the external business environment.",
   "category_minutes": {
    "Business Acumen": 60,
    "Ways of Working": 240,
    "Power Skills": 60
   }
  },
  {
   "domain": 8,
   "title": "Closure, transition, and lessons learned",
   "weight": 4.0,
   "chapter_count": 5,
   "summary": "Managing project artifacts and evaluating status through to the end, defining closure criteria and obtaining acceptance, validating readiness for transition to operations or the next phase, closing procurements, finances, and resources, and turning lessons learned into continuous improvement and updated organizational process assets.",
   "category_minutes": {
    "Business Acumen": 60,
    "Ways of Working": 180,
    "Power Skills": 0
   }
  },
  {
   "domain": 9,
   "title": "PMP exam readiness and applied review",
   "weight": 2.0,
   "chapter_count": 4,
   "summary": "Verified PMP® exam requirements and policies, strategies for each question format, a 30-item end-of-course assessment across all three domains and delivery approaches with worked rationales, and a targeted personal review plan.",
   "category_minutes": {
    "Business Acumen": 0,
    "Ways of Working": 120,
    "Power Skills": 0
   }
  }
 ],
