# Production configuration template. Use live IDs only. Never commit secrets.
PADDLE_ENVIRONMENT=production
PADDLE_CHECKOUT_ENABLED=false
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID_ASP=
PADDLE_PRICE_ID_CSP=
PADDLE_PRICE_ID_CIH=
# Store these two as Cloudflare Secrets, not public variables:
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# One-time extended access prices; configure separately in each environment.
PADDLE_PRICE_ID_ASP_180=
PADDLE_PRICE_ID_ASP_365=
PADDLE_PRICE_ID_CSP_180=
PADDLE_PRICE_ID_CSP_365=
PADDLE_PRICE_ID_CIH_180=
PADDLE_PRICE_ID_CIH_365=
